<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Demo_Application.MainAppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Demo_Application"
    FlyoutBehavior="Locked"
    Title="ZWaveJS.NET">

    <ShellContent
        Title="Zwave Runtime Information"
        ContentTemplate="{DataTemplate local:Information}"
        Route="Information"/>

    <ShellContent
        Title="Controller Firmware"
        ContentTemplate="{DataTemplate local:Information}"
        Route="ControllerFirmware"/>

    <ShellContent
        Title="ZWave Nodes"
        ContentTemplate="{DataTemplate local:Nodes}"
        Route="Nodes"/>



    <ShellContent
        Title="Network Rebuild"
        ContentTemplate="{DataTemplate local:Information}"
        Route="NetWorkRebuild"/>


</Shell>
