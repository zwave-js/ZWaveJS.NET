<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo_Application.Nodes"
             xmlns:local="clr-namespace:Demo_Application"
             Title="Nodes">
    <VerticalStackLayout>
        <ScrollView Padding="10">
            <CollectionView ItemsSource="{Binding Controller.Nodes.Array, Source={x:Static local:App.Driver}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <StackLayout Orientation="Horizontal"
                                     Padding="40"
                                     HorizontalOptions="Fill">

                            <Frame
                                Margin="5"
                                WidthRequest="100"
                                HeightRequest="78"
                                BackgroundColor="{StaticResource PrimaryDark}"
                                HorizontalOptions="Start">
                                <Label FontSize="28"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Text="{Binding id, StringFormat='#{0}'}"/>
                            </Frame>

                            <Frame
                                Margin="5"
                                HeightRequest="78"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="{StaticResource PrimaryDark}">
                                <Label FontSize="22"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Text="{Binding id, StringFormat='#{0}'}"/>
                            </Frame>

                            <Frame
                                Margin="5"
                                WidthRequest="110"
                                HeightRequest="78"
                                BackgroundColor="{StaticResource Tertiary}"
                                HorizontalOptions="Start">
                                <Label FontSize="14"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Text="SLEEP"/>
                            </Frame>

                            <Frame
                                Margin="5"
                                WidthRequest="110"
                                HeightRequest="78"
                                BackgroundColor="{StaticResource Gray600}"
                                HorizontalOptions="Start">
                                <Label FontSize="14"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Text="NOT READY"/>
                            </Frame>

                            <Frame
                                Margin="5"
                                WidthRequest="140"
                                HeightRequest="78"
                                BackgroundColor="{StaticResource Gray600}"
                                HorizontalOptions="Start">
                                <Label FontSize="14"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Text="NOT INTERVIEWED"/>
                            </Frame>




                        </StackLayout>



                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </VerticalStackLayout>
</ContentPage>